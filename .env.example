# Which commerce backend to use: mock | shopify | odoo
COMMERCE_PROVIDER=mock

# --- Shopify (only needed when COMMERCE_PROVIDER=shopify) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# --- Odoo (only needed when COMMERCE_PROVIDER=odoo) ---
ODOO_URL=https://your-odoo-instance.example.com
ODOO_DB=your-db-name
ODOO_API_KEY=

# --- Payments (server-side only, wired via PaymentService + API routes) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics / marketing (optional, add when ready) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
